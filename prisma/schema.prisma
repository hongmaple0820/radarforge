generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ 雷达层（1.0 核心） ============

model Topic {
  id          String   @id @default(cuid())
  name        String
  keywords    String   @default("")
  description String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  reports     Report[]
  ideas       Idea[]
}

model Report {
  id        String   @id @default(cuid())
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])
  title     String
  content   String   @default("") // markdown 早报正文
  mode      String   @default("DEMO") // REAL | DEMO
  provider  String   @default("") // 实际使用的 provider 名
  claims    Claim[]
  createdAt DateTime @default(now())
}

model Claim {
  id          String   @id @default(cuid())
  reportId    String?
  report      Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  runId       String?
  run         AgentRun? @relation("RunClaims", fields: [runId], references: [id], onDelete: Cascade)
  idx         Int // [n] 上标序号
  claimType   String   @default("fact") // fact | inference | opinion | experience
  text        String   @default("") // 主张文本（图文线）
  quote       String   @default("") // 引用的原文片段
  sourceTitle String   @default("")
  sourceUrl   String   @default("")
  sourceSite  String   @default("")
  sourceDate  String   @default("")
  kind        String   @default("FACT") // FACT | DATA | QUOTE | REF（早报线沿用）
  verified    Boolean?
}

// ============ Agent 运行时层（2.0 Phase 2） ============

model AgentRun {
  id          String   @id @default(cuid())
  kind        String   @default("skill") // skill（社区技能） | article（图文流水线） | image（纯图线）
  skillId     String   @default("") // skill 目录名（kind=skill）
  skillName   String   @default("")
  ideaTitle   String   @default("") // 选题标题（kind=article）
  ideaAngle   String   @default("") // 切入角度
  persona     String   @default("") // 写作人格
  theme       String   @default("radar") // 排版主题
  exemplarId  String   @default("") // 文风校准档案（style-exemplars 条目 id；空=不校准）
  input       String   @default("") // 用户输入 / 选题
  status      String   @default("queued") // queued | running | blocked | done | error
  mode        String   @default("DEMO") // REAL | DEMO
  steps       String   @default("[]") // JSON: [{name, status, detail, latencyMs}]
  artifacts   String   @default("{}") // JSON: {brief, review, publish…产物索引}
  output      String   @default("") // 产出 markdown
  error       String   @default("")
  ideas       Idea[]
  inboxItems  InboxItem[]
  claims      Claim[]  @relation("RunClaims")
  articles   Article[]
  reviews    ReviewRecord[]
  assets     Asset[]
  publishes  PublishRecord[]
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
}

model InboxItem {
  id         String   @id @default(cuid())
  targetType String   @default("run") // run | report
  targetId   String
  run        AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String?
  comment    String
  createdAt  DateTime @default(now())
}

model Idea {
  id         String   @id @default(cuid())
  title      String
  angle      String   @default("")
  score      Float    @default(0)
  status     String   @default("new") // new | picked | done
  topicId    String?
  topic      Topic?   @relation(fields: [topicId], references: [id])
  runId      String?
  run        AgentRun? @relation(fields: [runId], references: [id])
  createdAt  DateTime @default(now())
}

// ============ 图文流水线（Phase 2 核心产物） ============

model Article {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  version   Int      @default(0) // 0=初稿 1=审稿修订 …
  title     String   @default("")
  markdown  String   @default("") // 正文 markdown（含 [n]）
  formatted String   @default("") // 微信兼容 HTML（排版引擎输出）
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
}

model ReviewRecord {
  id         String   @id @default(cuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  round      Int      @default(1) // 第几轮审稿
  scoresJson String   @default("{}") // {accuracy, viewpoint, usefulness, voice, readability}
  commentsJson String @default("[]") // 每维一句意见
  average    Float    @default(0)
  revised    Boolean  @default(false) // 是否触发修订
  createdAt  DateTime @default(now())
}

model Asset {
  id         String   @id @default(cuid())
  runId      String?
  run        AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind       String   @default("image") // image | video | html
  role       String   @default("cover") // cover | inline
  provider   String   @default("")
  path       String   @default("") // /assets/… 静态可访问路径
  costCents  Int      @default(0)
  meta       String   @default("{}") // 尺寸/模型等
  error      String   @default("") // 生成失败留痕（降级不阻断）
  createdAt  DateTime @default(now())
}

model LearningRule {
  id        String   @id @default(cuid())
  runId     String?
  rule      String // 规则文本
  rationale String   @default("") // 从哪次修改提炼
  status    String   @default("proposed") // proposed | active | rejected
  hits      Int      @default(0) // 注入初稿次数
  createdAt DateTime @default(now())
}

model PublishRecord {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  platform    String   @default("wechat") // wechat | csdn
  level       Int      @default(2) // 1=草稿箱 API 2=粘贴加固 3=长图
  levelName   String   @default("") // 降级路径名
  reason      String   @default("") // 降级原因（诚实留痕）
  externalUrl String   @default("")
  htmlLength  Int      @default(0)
  createdAt   DateTime @default(now())
}

// ============ 模型网关层（插件注册表 + 健康记录） ============

model ProviderRecord {
  id           String   @id @default(cuid())
  kind         String // LLM | SEARCH | IMAGE | VIDEO
  name         String   @unique
  builtin      Boolean  @default(true) // 代码注册 or 插件注册
  configured   Boolean  @default(false) // 密钥是否就绪
  status       String   @default("unknown") // healthy | degraded | down | unknown
  lastLatency  Int      @default(0)
  lastError    String   @default("")
  calls        Int      @default(0)
  fails        Int      @default(0)
  lastChecked  DateTime?
  notes        String   @default("")
}

// ============ MCP 客户端层 ============

model McpServer {
  id              String   @id @default(cuid())
  name            String
  transport       String   @default("http") // http | sse | stdio
  url             String   @default("") // http/sse 用
  command         String   @default("") // stdio 用
  enabled         Boolean  @default(true)
  status          String   @default("unknown") // connected | error | unknown
  discoveredTools String   @default("[]") // JSON: [{name, description}]
  lastError       String   @default("")
  createdAt       DateTime @default(now())
  lastCheckedAt   DateTime?
}

// ============ 用户配置层（设置中心：模型密钥 / 创作风格定位） ============

model SettingKV {
  id        String   @id @default(cuid())
  key       String   @unique // provider:llm | provider:search | provider:image | style:profile
  value     String   @default("{}") // JSON
  updatedAt DateTime @updatedAt
}

// ============ 信源层（P1 p14：RSS/RSSHub 订阅 → 选题池） ============

model SourceFeed {
  id            String    @id @default(cuid())
  name          String // 展示名，如「机器之心」
  url           String    @unique // RSS/Atom 地址（RSSHub 路由拼好的完整 URL）
  category      String    @default("综合") // AI 资讯 / 研究前沿 / 开源生态 / 资本动向 …
  site          String    @default("") // 主站域名（解析 item link 时兜底）
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  lastStatus    String    @default("pending") // ok | partial | error | pending（诚实留痕）
  lastError     String    @default("") // 失败原因（人话）
  lastItemCount Int       @default(0) // 最近一次新增条目数
  note          String    @default("")
  createdAt     DateTime  @default(now())
  items         FeedItem[]
}

model FeedItem {
  id         String   @id @default(cuid())
  feed       SourceFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  feedId     String
  guid       String // feed 内唯一标识（RSS guid / Atom id；缺省用 link 哈希）
  title      String
  url        String   @default("")
  site       String   @default("")
  summary    String   @default("") // description/summary 去标签截断
  simhash    String   @default("") // 64-bit 十六进制（标题+摘要，跨源去重用）
  publishedAt DateTime?
  status     String   @default("new") // new | promoted(转选题) | skipped
  ideaId     String?  // 转选题后回填（溯源动线）
  createdAt  DateTime @default(now())

  @@unique([feedId, guid])
  @@index([simhash])
}
