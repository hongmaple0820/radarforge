/local-*

server.log
# Skills directory
/skills/

# ===== 密钥与本地运行时（严禁入库）=====
# SQLite 库内含设置中心密钥（SettingKV），.env 历史曾泄露真实密钥，已 filter-repo 全历史清洗
.env*
!.env.example
/db/*.db
/db/*.db-journal
*.pid

# 本地插件工作区与临时产物（本地保留，不入库）
/skill-pool/
/tool-results/
.claude
.z-ai-config
# y4 帧库原始图（可由 scripts/gen-y4-frames.mjs 再生）
/scripts/y4-frames-raw/
# 运行时产物：新视频/封面不入库（历史已跟踪的不受影响）
/public/assets/*.mp4
/public/assets/cover-*.png
/public/assets/video-segs/
# 用户交付物目录
/download/
/public/assets/ill-*.png
/public/assets/card-*.png

